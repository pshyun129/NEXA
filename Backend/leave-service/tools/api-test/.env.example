# 이 파일을 .env로 복사한다. 값 안의 #은 그대로 읽으므로 줄 끝 주석은 쓰지 않는다.
BASE_URL=https://nexa-erp.duckdns.org
ENVIRONMENT=ec2-dev
# 내부 날짜 GET의 Leave 직접 주소. 외부 Gateway 익명 허용으로 가정하지 않는다.
INTERNAL_LEAVE_URL=
HTTP_TIMEOUT=10
POLL_TIMEOUT=30
# 기본 false는 관리자 취소의 503/LEAVE_025 차단만 검증한다.
# 서버 원복 연동을 검증·활성화한 전용 테스트 환경에서만 true로 변경한다.
TEST_ADMIN_CANCEL_ENABLED=false

# 로그인은 POST /api/v1/auth/login, JSON {"email": ..., "pass": ...}.
# accessToken 쿠키를 계정별 Session에서 재사용한다. JWT를 직접 넣지 않는다.
ADMIN_EMAIL=leaveadmin@local.dev
ADMIN_PASS=
ORDINARY_EMAIL=
ORDINARY_PASS=
TEAMLEAD_EMAIL=
TEAMLEAD_PASS=
APPROVER_EMAIL=
APPROVER_PASS=
# 상위 결재자가 추가되는 경우에만 입력한다.
APPROVER2_EMAIL=
APPROVER2_PASS=

# 공용 서버의 다른 직원이 아닌 전용 테스트 직원임을 확인한 후 켠다.
ALLOW_WRITES=false
DEDICATED_EMPLOYEE_CONFIRMED=false
EXPECTED_EMPLOYEE_ID=

# 고정 기준 지급 식별자. 최초 지급 이후 변경하지 않는다. ASCII 1~20자.
DATA_KEY=LEAVE_TEST
# SQL 01 실행 결과만 먼저 입력한다.
BALANCE_TYPE_ID=
# SQL 02는 정책 버전·직원 배정 API 이후 수동 실행한다. 기존 지급을 재사용한다.
ACCOUNT_ID=
GRANT_ID=
INITIAL_GRANT_ENTRY_ID=
