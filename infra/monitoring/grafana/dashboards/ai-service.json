    {
      "type": "timeseries",
      "title": "일별 자동 확정률",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ai-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ai-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', created_at) AS time,\n       avg(CASE WHEN label_source = 'llm_agree' THEN 1.0 ELSE 0.0 END) AS \"자동 확정률\"\nFROM run_feedback\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "기록 없음",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "id": 14
    },
    {
      "type": "table",
      "title": "모델 버전별 사람 수정률",
      "description": "store 수정률이 높으면 OCR, total·date가 높으면 LLM(프롬프트) 쪽 문제일 가능성",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ai-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ai-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT model_version AS \"모델 버전\",\n       count(*) AS \"사람 확인\",\n       round(100.0 * avg(CASE WHEN edited_fields ? 'store' THEN 1 ELSE 0 END), 1) AS \"store 수정률(%)\",\n       round(100.0 * avg(CASE WHEN edited_fields ? 'total' THEN 1 ELSE 0 END), 1) AS \"total 수정률(%)\",\n       round(100.0 * avg(CASE WHEN edited_fields ? 'date'  THEN 1 ELSE 0 END), 1) AS \"date 수정률(%)\"\nFROM run_feedback\nWHERE label_source = 'human' AND $__timeFilter(created_at)\nGROUP BY model_version\nORDER BY model_version"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "기간 안에 사람 확인 기록 없음"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 15
    },
    {
      "type": "table",
      "title": "최근 실패한 노드",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ai-db"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ai-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT started_at AS \"시각\", run_id AS \"실행\", node_type AS \"노드\", left(error, 150) AS \"에러\"\nFROM run_step\nWHERE status = 'FAILED' AND $__timeFilter(started_at)\nORDER BY started_at DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "기간 안에 실패한 노드 없음 ✅"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 16
    }
