# ---------- 공통 ----------
GPU_ID=1

# ---------- vLLM (LLM 서빙) ----------
MODEL_PATH=$HOME/ai/models/Qwen3.8-27B-FP8
SERVED_MODEL_NAME=qwen3.8-27b
PORT=18080
VLLM_API_KEY=change-me
GPU_MEM_UTIL=0.29
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=8
VLLM_USE_DEEP_GEMM=0

# ---------- MLflow (실험 기록·모델 레지스트리) ----------
MLFLOW_PORT=18200
MLFLOW_ALLOWED_HOSTS=localhost:18200,127.0.0.1:18200,100.119.105.3:18200,k15d107-gpu:18200
# 웹 화면에서 여는 주소 (비우면 위 호스트마다 http://호스트 로 자동). 없으면 화면의 목록 검색(POST)이 403으로 막힘
MLFLOW_CORS_ALLOWED_ORIGINS=