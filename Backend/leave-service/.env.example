# Nexa 개발 EC2 환경변수 템플릿
# CI/CD는 /opt/nexa-dev/.env를 읽는다. 실제 값은 EC2의 .env에만 입력한다.
# 빈 필수값을 채운 뒤 docker compose --env-file /opt/nexa-dev/.env -f compose.dev.yml config --quiet로 확인한다.

# 1. 전체 스택 기동 필수값
# 기존 DB 볼륨을 사용한다면 이미 생성된 계정의 비밀번호와 맞춘다.
POSTGRES_PASSWORD=
USER_DB_PASSWORD=
LEAVE_DB_PASSWORD=
APPROVAL_DB_PASSWORD=
ATTENDANCE_DB_PASSWORD=
PAYROLL_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
AI_DB_PASSWORD=

EUREKA_USER=
EUREKA_PASSWORD=

CONFIG_GIT_URI=git@github.com:pshyun129/nexa-config.git
CONFIG_GIT_PRIVATE_KEY=
GITHUB_SSH_HOST_KEY=
CONFIG_SERVER_PASSWORD=

# 2. 전체 스택 기동 선택값
POSTGRES_DB=nexa
POSTGRES_USER=nexa_admin
POSTGRES_PORT=5433

# 3. AI 모델 연동
# 사용하는 제공자의 값만 설정한다. URL·모델·타임아웃을 생략하면 Compose 기본값을 사용한다.
# LOCAL_LLM_BASE_URL=
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_MODEL=
# LOCAL_LLM_TIMEOUT=
# GMS_BASE_URL=
# GMS_API_KEY=
# GMS_MODEL=

# 4. Leave Service 기능 연동
# 아래 변수는 현재 Leave Compose에 자동 전달되지 않는다.
# 실제 연동 배포 시 infra/compose/backend.yml의 leave-service.environment에 필요한 항목을 매핑한다.
# Leave 포트 8082, DB 주소·계정, JWT_JWKS_URI는 현재 Compose에서 지정한다.

# 휴가 신청·결재 HTTP 및 Kafka 결과 정산
# 같은 Docker 네트워크 기준 예시다. Kafka 9092를 EC2 외부에 공개할 필요는 없다.
# base-url이 비어 있으면 Eureka + LoadBalancer, 지정하면 일반 HTTP 직접 호출이다.
# LEAVE_APPROVAL_BASE_URL=
# LEAVE_APPROVAL_SERVICE_ID=approval-service
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# LEAVE_APPROVAL_RESULTS_GROUP_ID=leave-service
# LEAVE_APPROVAL_CONNECT_TIMEOUT=2s
# LEAVE_APPROVAL_READ_TIMEOUT=3s
# 반려 후 재기안 금지 반영, 일수·출처 계약, Kafka 인증·ACL·DLT 및 종단 검증 후 네 값을 함께 true로 변경한다.
# LEAVE_APPROVAL_ENABLED=false
# LEAVE_APPROVAL_HTTP_CONTRACT_VERIFIED=false
# LEAVE_APPROVAL_RESULTS_ENABLED=false
# LEAVE_APPROVAL_RESULTS_CONTRACT_VERIFIED=false
# Kafka ACL은 approval.document.result 읽기, 소비 그룹 사용, approval.document.result.DLT 쓰기가 필요하다.
# 브로커가 인증을 요구하면 배포 환경의 Spring Kafka 보안 설정과 비밀값도 별도로 주입한다.

# 공휴일 조회. Eureka로 호출하는 경우 기본 서비스 이름 attendance-service를 사용한다.
# 고정 주소가 필요한 경우 실제 내부 주소를 지정한다.
# LEAVE_ATTENDANCE_BASE_URL=
# LEAVE_ATTENDANCE_SERVICE_ID=attendance-service
# LEAVE_ATTENDANCE_CONNECT_TIMEOUT=2s
# LEAVE_ATTENDANCE_READ_TIMEOUT=3s

# User Service 기반 부서별 조회. 운영 직책 데이터와 세 API의 접근 권한을 확인한 뒤 활성화한다.
# LEAVE_HR_ENABLED=false
# LEAVE_HR_BASE_URL=
# LEAVE_HR_SERVICE_ID=user-service
# LEAVE_HR_EMPLOYEE_INFO_URI=/api/v1/employees/{employeeId}
# LEAVE_HR_DEPARTMENT_MEMBERS_URI=/api/v1/employees?deptId={departmentId}
# LEAVE_HR_DUTY_INFO_URI=/api/v1/duties/{dutyId}
# LEAVE_HR_JWT_DEPARTMENT_ID_CLAIM=deptId
# LEAVE_HR_JWT_DUTY_ID_CLAIM=dutyId
# LEAVE_HR_CONNECT_TIMEOUT=2s
# LEAVE_HR_READ_TIMEOUT=3s

# 관리자 직접 취소는 실제 Approval 철회 연동이 준비될 때까지 비활성화한다.
# LEAVE_APPROVAL_WITHDRAWAL_ENABLED=false
